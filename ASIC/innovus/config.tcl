###############################################################################
# config.tcl  --  Paths and knobs for the Innovus place-and-route runs
#
# Mirrors ASIC/genus/config.tcl so the two halves of the flow stay consistent.
# Everything that changes between machines or designs lives here; run_innovus.tcl
# contains only the flow steps and reads its settings from this file.
#
# Driven by three environment variables (exported by run_innovus.sh):
#   REPO_ROOT    - top of the IC-Design checkout
#   INNOVUS_DIR  - this directory (ASIC/innovus)
#   DESIGN       - which design to run: alu | core | system | soc
###############################################################################

set REPO_ROOT   $env(REPO_ROOT)
set INNOVUS_DIR $env(INNOVUS_DIR)
set DESIGN      $env(DESIGN)

###############################################################################
# SKY130 open_pdks settings  (same PDK the Genus side uses)
#   NOTE: these paths are on the LAB LINUX MACHINE, not your laptop.
#   If your install lives elsewhere, override PDK_ROOT in your shell:
#     export PDK_ROOT=/your/path/sky130A
###############################################################################
if {[info exists env(PDK_ROOT)]} {
    set PDK_ROOT $env(PDK_ROOT)
} else {
    set PDK_ROOT /opt/open_pdks/sky130/sky130A
}
set STD_CELL      sky130_fd_sc_hd
set STD_REF       $PDK_ROOT/libs.ref/$STD_CELL

# Liberty (timing) -- must match the corner Genus synthesized against (tt, 25C, 1.8V)
set STD_LIB       $STD_REF/lib/${STD_CELL}__tt_025C_1v80.lib

# Physical views for the standard cells
set TECH_LEF      $STD_REF/techlef/${STD_CELL}__nom.tlef
set STD_CELL_LEF  $STD_REF/lef/${STD_CELL}.lef
set STD_GDS       $STD_REF/gds/${STD_CELL}.gds

# GDS stream-out layer map shipped with open_pdks (used at streamOut)
set GDS_MAP       $PDK_ROOT/libs.tech/klayout/tech/sky130A.map

# Placement/routing site and top metal layer for sky130_fd_sc_hd
set CORE_SITE     unithd
set MAX_ROUTE_LAYER 5

###############################################################################
# SRAM macro  (sky130_sram_2kbyte_1rw1r_32x512_8, from VLSIDA/sky130_sram_macros)
#
# Only the designs that instantiate SRAM need these.  The *.v behavioral model
# is in RTL/memory, but P&R needs the PHYSICAL views (LEF/LIB/GDS) generated by
# OpenRAM.  Drop them on the lab machine and point SRAM_DIR at them:
#     export SRAM_DIR=/path/to/sky130_sram_macros/sky130_sram_2kbyte_1rw1r_32x512_8
###############################################################################
set SRAM_NAME     sky130_sram_2kbyte_1rw1r_32x512_8
if {[info exists env(SRAM_DIR)]} {
    set SRAM_DIR $env(SRAM_DIR)
} else {
    set SRAM_DIR $REPO_ROOT/ASIC/macros/$SRAM_NAME
}
set SRAM_LEF      $SRAM_DIR/$SRAM_NAME.lef
set SRAM_LIB      $SRAM_DIR/$SRAM_NAME.lib
set SRAM_GDS      $SRAM_DIR/$SRAM_NAME.gds

###############################################################################
# Per-design settings
#   TOP_OF      : top cell name in the synthesized netlist (matches Genus)
#   USES_SRAM   : 1 if the design contains SRAM macros, 0 otherwise
###############################################################################
array set TOP_OF {
    alu     alu_synth_top
    core    core
    system  system
    soc     soc
}
array set USES_SRAM {
    alu     0
    core    0
    system  1
    soc     1
}

if {![info exists TOP_OF($DESIGN)]} {
    puts "ERROR: unknown DESIGN '$DESIGN' (expected: [array names TOP_OF])"
    exit 1
}
set TOP_MODULE $TOP_OF($DESIGN)
set HAS_SRAM    $USES_SRAM($DESIGN)

###############################################################################
# Handoff from Genus  (Person 1 writes <design>_netlist.v and <design>.sdc)
###############################################################################
set GENUS_OUT $REPO_ROOT/ASIC/genus/out/$DESIGN
set NETLIST   $GENUS_OUT/${DESIGN}_netlist.v
set SDC_FILE  $GENUS_OUT/${DESIGN}.sdc

###############################################################################
# Power / ground
#   These are the logical PnR net names.  globalNetConnect (in run_innovus.tcl)
#   ties them to the physical cell pins:
#     VPWR/VPB -> VDD, VGND/VNB -> VSS  (standard cells)
#     vccd1    -> VDD, vssd1    -> VSS  (SRAM macro)
###############################################################################
set POWER_NET  VDD
set GROUND_NET VSS

###############################################################################
# Floorplan knobs  (start loose; tighten once the design is clean)
#   TARGET_UTIL  : standard-cell area utilization (0.0-1.0)
#   ASPECT       : core aspect ratio (height/width)
#   CORE_MARGIN  : gap (um) between core edge and I/O / die edge, all sides
###############################################################################
set TARGET_UTIL  0.55
set ASPECT       1.0
set CORE_MARGIN  25

###############################################################################
# Output / report directories  (git-ignored; see repo-root .gitignore)
###############################################################################
set OUT_DIR $INNOVUS_DIR/out/$DESIGN
set RPT_DIR $INNOVUS_DIR/reports/$DESIGN
set DBS_DIR $INNOVUS_DIR/dbs/$DESIGN
